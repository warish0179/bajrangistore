generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  passwordHash    String
  role            String            @default("CUSTOMER") // CUSTOMER, SELLER, DELIVERY_WORKER, ADMIN
  phone           String?
  gender          String?           // MALE, FEMALE, OTHER
  dob             String?
  panNumber       String?
  referralCode    String?
  avatar          String?
  walletBalance   Float             @default(500.0) // Welcome wallet bonus
  isVerified      Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  addresses       Address[]
  orders          Order[]           @relation("CustomerOrders")
  reviews         Review[]
  wishlist        WishlistItem[]
  cart            CartItem[]
  notifications   Notification[]
  sellerProfile   SellerProfile?
  deliveryProfile DeliveryProfile?
  supportChats    SupportMessage[]
  supportTickets  SupportTicket[]
  transactions    PaymentTransaction[]
  returnRequests  ReturnRequest[]
}

model SellerProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName   String
  storeSlug   String    @unique
  description String?
  logo        String?
  banner      String?
  rating      Float     @default(4.8)
  totalSales  Int       @default(0)
  isApproved  Boolean   @default(true)
  gstNumber       String?
  panNumber       String?
  bankAccount     String?
  commissionRate  Float     @default(5.0) // 5% platform commission
  phone           String?
  businessAddress String?
  pickupAddress   String?
  kycDocuments    String?   // JSON string of document URLs
  status          String    @default("APPROVED") // PENDING, APPROVED, REJECTED, SUSPENDED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  products        Product[]
}

model DeliveryProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                String?
  phone                   String?
  vehicleType             String    @default("BIKE") // BIKE, SCOOTER, EV_VAN
  vehicleNumber           String    @default("KA-05-EX-4891")
  licenseNumber           String?
  aadhaarNumber           String?
  panNumber               String?
  bankAccount             String?
  ifscCode                String?
  upiId                   String?
  emergencyContact        String?
  status                  String    @default("APPROVED") // PENDING, APPROVED, REJECTED, SUSPENDED
  kycDocuments            String?   // JSON string
  isOnline                Boolean   @default(true)
  currentCity             String    @default("Bengaluru")
  activeDeliveriesCount   Int       @default(0)
  completedDeliveriesCount Int      @default(0)
  totalEarnings           Float     @default(0.0)
  rating                  Float     @default(4.9)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  assignedOrders          Order[]   @relation("DeliveryWorkerOrders")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  houseNumber String?
  street      String
  area        String?
  landmark    String?
  city        String
  state       String
  postalCode  String
  country     String   @default("India")
  isDefault   Boolean  @default(false)
  type        String   @default("HOME") // HOME, WORK, OTHER
  createdAt   DateTime @default(now())
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  icon        String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  featured    Boolean    @default(false)
  createdAt   DateTime   @default(now())

  products    Product[]
}

model Product {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  description     String
  brand           String           // Real brand e.g. Samsung, Apple, Nike
  manufacturer    String?
  modelNumber     String?
  videoUrl        String?
  warranty        String?          @default("1 Year Manufacturer Warranty")
  returnPolicy    String?          @default("7 Days Replacement / Return")
  sku             String?          @unique
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  sellerId        String?
  seller          SellerProfile?   @relation(fields: [sellerId], references: [id])
  basePrice       Float
  salePrice       Float
  discountPercent Int              @default(0)
  rating          Float            @default(4.5)
  reviewCount     Int              @default(0)
  stock           Int              @default(50)
  isFeatured      Boolean          @default(false)
  isDealOfTheDay  Boolean          @default(false)
  isFlashDeal     Boolean          @default(false)
  flashDealEndsAt DateTime?
  tags            String?          // comma separated tags
  specs           String?          // JSON string of key-value specs
  highlights      String?          // JSON array string of bullets
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images          ProductImage[]
  variants        ProductVariant[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
}

model ProductVariant {
  id         String     @id @default(cuid())
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String     // e.g. "Color: Space Gray, Size: 256GB"
  sku        String     @unique
  price      Float
  salePrice  Float
  stock      Int        @default(20)
  attributes String?    // JSON string e.g. {"color":"Black","size":"256GB"}
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  title            String
  comment          String
  images           String?  // JSON string array of image URLs
  helpfulCount     Int      @default(0)
  verifiedPurchase Boolean  @default(true)
  isApproved       Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model CartItem {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, productId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String
  discountType   String    // "PERCENT" or "FIXED"
  discountValue  Float
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  usageLimit     Int       @default(1000)
  timesUsed      Int       @default(0)
  createdAt      DateTime  @default(now())
}

model Order {
  id                  String             @id @default(cuid())
  orderNumber         String             @unique
  userId              String
  user                User               @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Cascade)
  deliveryWorkerId    String?
  deliveryWorker      DeliveryProfile?   @relation("DeliveryWorkerOrders", fields: [deliveryWorkerId], references: [id])
  totalAmount         Float
  discountAmount      Float              @default(0)
  shippingFee         Float              @default(0)
  taxAmount           Float              @default(0)
  finalAmount         Float
  status              String             @default("CONFIRMED") // ORDER_PLACED, PAYMENT_PENDING, CONFIRMED, SELLER_PROCESSING, PACKED, READY_FOR_PICKUP, ASSIGNED_TO_DELIVERY, PICKED_UP, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, RETURN_REQUESTED, RETURNED, REFUNDED
  paymentStatus       String             @default("PAID")      // PENDING_VERIFICATION, PAID, FAILED, REFUNDED
  paymentMethod       String             @default("UPI_QR")    // UPI_QR, BANK_TRANSFER, CARD, COD, WALLET
  transactionId       String?            // UTR Number or Gateway Transaction ID
  shippingAddress     String             // JSON string of address details
  trackingNumber      String?
  courierName         String?
  deliveryOtp         String?            @default("8942")      // OTP customer gives to delivery driver
  deliveryProofNote   String?
  deliveryProofPhoto  String?
  codCollected        Boolean            @default(false)
  codAmount           Float              @default(0)
  notes               String?
  cancelReason        String?
  returnReason        String?
  refundAmount        Float?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  items               OrderItem[]
  timeline            OrderTimeline[]
  paymentTransactions PaymentTransaction[]
  returnRequests      ReturnRequest[]
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productTitle String
  variantName  String?
  productImage String
  price        Float
  quantity     Int
  total        Float
}

model OrderTimeline {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  title       String
  description String?
  location    String?
  timestamp   DateTime @default(now())
}

model PaymentSetting {
  id                  String   @id @default("default-setting")
  upiId               String   @default("9835400188-k322-3@ibl")
  upiQrImage          String   @default("/payments/bajrangi_upi_qr.jpg")
  accountHolder       String   @default("Warish Raj")
  accountNumber       String   @default("000521713102565")
  ifscCode            String   @default("JIOP0000001")
  bankName            String   @default("Jio Payments Bank")
  paymentInstructions String   @default("Scan the PhonePe/Jio Payments QR code or transfer to UPI ID / Bank details. Submit your 12-digit UTR/Reference number for instant automated approval.")
  isUpiActive         Boolean  @default(true)
  isBankTransferActive Boolean @default(true)
  isCodActive         Boolean  @default(true)
  isWalletActive      Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model PaymentTransaction {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  paymentMethod  String    // UPI_QR, BANK_TRANSFER, CARD, COD, WALLET
  transactionRef String?   // 12-digit UTR / reference number submitted by user
  receiptImage   String?
  status         String    @default("APPROVED") // PENDING_VERIFICATION, APPROVED, REJECTED, REFUNDED
  verifiedBy     String?
  verifiedAt     DateTime?
  adminNote      String?
  createdAt      DateTime  @default(now())
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketNumber String  @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  category    String   @default("DELIVERY") // PAYMENT, DELIVERY, RETURN, PRODUCT, SELLER
  priority    String   @default("MEDIUM")   // LOW, MEDIUM, HIGH, URGENT
  status      String   @default("OPEN")     // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  messages    String   // JSON string of conversation array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("ORDER") // ORDER, PROMO, PRICE_DROP, SYSTEM, DELIVERY
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  image       String
  link        String   @default("/products")
  buttonText  String   @default("Shop Now")
  badge       String?
  type        String   @default("HERO") // HERO, PROMO, CATEGORY
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model SupportMessage {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId   String
  sender      String   // USER, BOT, AGENT
  message     String
  quickActions String? // JSON array of options
  createdAt   DateTime @default(now())
}

model ReturnRequest {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("RETURN") // RETURN, REPLACEMENT
  reason      String
  condition   String?  // UNOPENED, DEFECTIVE, WRONG_ITEM
  pickupDate  String?
  images      String?  // JSON string
  status      String   @default("PENDING") // PENDING, APPROVED, PICKED_UP, REFUNDED, REJECTED
  refundType  String   @default("WALLET")  // WALLET, ORIGINAL_SOURCE
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OtpVerification {
  id         String   @id @default(cuid())
  identifier String   // email or mobile
  otp        String
  purpose    String   @default("LOGIN") // LOGIN, REGISTER, FORGOT_PASSWORD
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}
